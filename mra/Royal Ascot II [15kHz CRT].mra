<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Royal Ascot II (Model 2C-CRX). Derived from MAME 0.289 model2.cpp
      ROM_START(rascot2). For the Model 2C build of the 2A core (Model2.sv
      M2_2C); the 2A and original cores cannot run it. Study R1010.

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py's functions):
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window, ROM_COPY
                   mirrors written out)
        0x2080000  4 MB of zeros (the 2C core keeps the TGPx4's program copy
                   at its start, written by the upload)
        0x2480000  256 KB of zeros (the 2A TGP's tables; 2C has none)
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB
        0x2D40000  i960 program 512 KB-2 MB
        0x2EC0000  copro data, 4 MB: zeros (MAME's region is ROMREGION_ERASE00)
        0x32C0000  texture-coordinate ROM, 16 MB (MAME's region tiled, as its
                   mask reads it)
        0x42C0000  polygons, 32 MB
      Image: 0x62C0000 bytes. NOT LOADED: nothing else.

      Index 4, the game ID: 0x24 (R1010). Bit 7 is SET in this MRA (0xA4): the
      15 kHz CRT flag (R795), which starts the core in 15 kHz interlaced
      whatever the OSD says (R908).
    -->
    <name>Royal Ascot II [15kHz CRT]</name>
    <setname>rascot2</setname>
    <rbf>Model2C</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>A4 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>Sega</manufacturer>
    <category>Horse racing</category>

    <rom index="0" zip="rascot2.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-20166.15" crc="520479a4" map="0021"/>
            <part name="epr-20167.16" crc="e92f3d55" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-20164.13" crc="576a15dc" map="0021"/>
            <part name="epr-20165.14" crc="7527f33b" map="2100"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <interleave output="32">
            <part name="mpr-20171.11" crc="9f2327c6" map="0021"/>
            <part name="mpr-20172.12" crc="40b4f8e6" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20169.9" crc="b5be4d6b" map="0021"/>
            <part name="mpr-20170.10" crc="7b05cf33" map="2100"/>
        </interleave>
        <part repeat="16777216">00</part>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB: none on 2C -->
        <part repeat="262144">00</part>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-20168.31" crc="13a6a78d" map="12"/>
        </interleave>
        <part repeat="393216">00</part>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-20185.32" crc="168cc361" map="12"/>
        </interleave>
        <part repeat="6291456">00</part>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <part repeat="1572864">00</part>

        <!-- 0x2EC0000  copro data, 4 MB (R862, R924) -->
        <part repeat="4194304">00</part>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897) -->
        <interleave output="32">
            <part name="mpr-20183.27" crc="48520d72" map="0021"/>
            <part name="mpr-20181.25" crc="99bfa480" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20184.28" crc="b8df0b12" map="0021"/>
            <part name="mpr-20182.26" crc="e3f085fe" map="2100"/>
        </interleave>

        <!-- 0x42C0000  polygons, 32 MB (R897) -->
        <interleave output="32">
            <part name="mpr-20173.17" crc="60bd684e" map="0021"/>
            <part name="mpr-20177.21" crc="4ba5199d" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20174.18" crc="6751ada5" map="0021"/>
            <part name="mpr-20178.22" crc="f4fa00aa" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20175.19" crc="801f4eff" map="0021"/>
            <part name="mpr-20179.23" crc="bd2c4e65" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20176.20" crc="50cb6b5a" map="0021"/>
            <part name="mpr-20180.24" crc="df16f2ca" map="2100"/>
        </interleave>

    </rom>

    <!-- KNOWN NOT WORKING: a satellite terminal. It waits for its SegaNet
         hub (Shot 1 skips the wait) and then stays on the title screen, as
         in MAME: the game needs its network and main unit (study R1010). -->
    <buttons names="Shot 1,Button 2,Button 3,Start,Coin,Test,Service"/>
</misterromdescription>
