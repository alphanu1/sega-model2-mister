<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Layout contract: docs/rom-layout.md. Derived from MAME 0.289
      model2.cpp ROM_START(vcopa).

      R299: ONE LAYOUT SERVES EVERY GAME. Slots are sized to the largest game
      in each region -- Daytona everywhere except the i960 program, where this
      game and Desert Tank load FOUR ROMs against Daytona's two. What this game
      does not fill is padded with FF, because unwritten memory reads 0xFFFF on
      this board; the two regions MAME declares ROMREGION_ERASE00 are padded
      with 00 instead, because that is what the hardware model says they read.

      All 20 filenames and CRCs match MAME 0.289 exactly.
    -->
    <name>Virtua Cop</name>
    <setname>vcopa</setname>
    <rbf>Model2</rbf>
    <nvram index="2" size="16384"/>
    <!-- The I/O board's Z80 firmware, shared with Daytona (study R61). -->
    <rom index="3" zip="model1io.zip|daytona93.zip" md5="none">
        <part name="epr-14869c.25"/>
    </rom>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Sega</manufacturer>
    <category>Shooter</category>

    <rom index="0" zip="vcopa.zip" md5="none">

        <!-- 0x0000000  i960 program, 0x80000 (full) -->
        <interleave output="32">
            <part name="epr-17166a.12" crc="702566e6" map="0021"/>
            <part name="epr-17167a.13" crc="9b8e05a8" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-17160a.14" crc="267f3242" map="0021"/>
            <part name="epr-17161a.15" crc="f7126876" map="2100"/>
        </interleave>

        <!-- 0x0080000  i960 data, 0xa00000 (0x900000 used) -->
        <interleave output="32">
            <part name="mpr-17164.10" crc="ac5fc501" map="0021"/>
            <part name="mpr-17165.11" crc="82296d00" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-17162.8" crc="60ddd41e" map="0021"/>
            <part name="mpr-17163.9" crc="8c1f9dc8" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-17168a.6" crc="59091a37" map="0021"/>
            <part name="epr-17169a.7" crc="0495808d" map="2100"/>
        </interleave>
        <part repeat="1048576">FF</part>

        <!-- 0x0a80000  copro data, 0x400000 -- ROMREGION_ERASE00 in MAME:
             this game ships no collision/height map at all. -->
        <part repeat="4194304">00</part>

        <!-- 0x0e80000  textures, 0x800000 (0x400000 used) -->
        <interleave output="32">
            <part name="mpr-17158.25" crc="1108d1ec" map="0021"/>
            <part name="mpr-17157.24" crc="cf31e33d" map="2100"/>
        </interleave>
        <part repeat="4194304">FF</part>

        <!-- 0x1680000  polygons, 0xd00000 (0x400000 used) -->
        <interleave output="32">
            <part name="mpr-17159.16" crc="e218727d" map="0021"/>
            <part name="mpr-17156.20" crc="c4f4aabf" map="2100"/>
        </interleave>
        <part repeat="9437184">FF</part>

        <!-- 0x2380000  68000 sound program, 0x40000 (full, byte-swapped) -->
        <interleave output="16">
            <part name="epr-17170.7" crc="06a38ae2" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="epr-17171.8" crc="b5e436f8" map="12"/>
        </interleave>

        <!-- 0x23c0000  MPCM samples, 0x800000. MPCM1 loads at 0x000000 and
             0x200000 with a 0x100000 hole between: MAME's offsets, kept. -->
        <part name="mpr-17172.32" crc="ab22cac3"/>
        <part repeat="1048576">FF</part>
        <part name="mpr-17173.33" crc="3cb4005c"/>
        <part repeat="1048576">FF</part>
        <part name="mpr-17174.4" crc="a50369cc"/>
        <part name="mpr-17175.5" crc="9136d43c"/>

        <!-- 0x2bc0000  comms program, 0x20000 -- none in this set. -->
        <part repeat="131072">00</part>

        <!-- 0x2be0000  TGP math tables, 0x40000 (shared Model 2 CPU board) -->
        <interleave output="32">
            <part name="opr-14742a.45" crc="90c6b117" map="0021"/>
            <part name="opr-14743a.46" crc="ae7f446b" map="2100"/>
        </interleave>

    </rom>
</misterromdescription>
