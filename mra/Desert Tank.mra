<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Layout contract: docs/rom-layout.md. Derived from MAME 0.289
      model2.cpp ROM_START(desert).

      R299: ONE LAYOUT SERVES EVERY GAME, and the slots are sized to the
      LARGEST game in each region rather than to this one. Daytona is the
      biggest everywhere except the i960 program, where Desert Tank and Virtua
      Cop load FOUR ROMs against Daytona's two -- so the program slot is
      0x80000 and Daytona pads. Everything this game does not fill is padded
      here with FF, because unwritten memory reads 0xFFFF on this board.

      TWO FILENAMES DIFFER FROM MAME AND THE CRCs DO NOT. mpr-16964 and
      mpr-16965 carry socket suffixes .21/.20 in the available set where MAME
      names them .20/.21. Matched by CRC, which is the ROM's identity; the
      suffix is only which socket it sat in. All 22 CRCs verified against
      MAME 0.289.
    -->
    <name>Desert Tank</name>
    <setname>desert</setname>
    <rbf>Model2</rbf>
    <nvram index="2" size="16384"/>
    <!-- The I/O board's Z80 firmware, shared with Daytona (study R61). -->
    <rom index="3" zip="model1io.zip|daytona93.zip" md5="none">
        <part name="epr-14869c.25"/>
    </rom>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Sega</manufacturer>
    <category>Simulation</category>

    <rom index="0" zip="desert.zip" md5="none">

        <!-- 0x0000000  i960 program, 0x80000 (full) -->
        <interleave output="32">
            <part name="epr-16976.12" crc="d036dff0" map="0021"/>
            <part name="epr-16977.13" crc="e91194bd" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-16970.14" crc="4ea12d1f" map="0021"/>
            <part name="epr-16971.15" crc="d630b220" map="2100"/>
        </interleave>

        <!-- 0x0080000  i960 data, 0xa00000 (0x900000 used) -->
        <interleave output="32">
            <part name="mpr-16974.10" crc="2ab491c5" map="0021"/>
            <part name="mpr-16975.11" crc="e24fe7d3" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16972.8" crc="23e53748" map="0021"/>
            <part name="mpr-16973.9" crc="77d6f509" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-16978.6" crc="38b3e574" map="0021"/>
            <part name="epr-16979.7" crc="c314eb8b" map="2100"/>
        </interleave>
        <part repeat="1048576">FF</part>

        <!-- 0x0a80000  copro data, 0x400000 (0x100000 used) -->
        <interleave output="32">
            <part name="epr-16981.28" crc="ae847571" map="0021"/>
            <part name="epr-16980.29" crc="5239b864" map="2100"/>
        </interleave>
        <part repeat="3145728">FF</part>

        <!-- 0x0e80000  textures, 0x800000 (0x400000 used) -->
        <interleave output="32">
            <part name="mpr-16967.25" crc="b8b84c9d" map="0021"/>
            <part name="mpr-16966.24" crc="7484efe9" map="2100"/>
        </interleave>
        <part repeat="4194304">FF</part>

        <!-- 0x1680000  polygons, 0xd00000 (0x800000 used) -->
        <interleave output="32">
            <part name="mpr-16968.16" crc="4a16f465" map="0021"/>
            <part name="mpr-16964.21" crc="d4a769b6" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16969.17" crc="887380ac" map="0021"/>
            <part name="mpr-16965.20" crc="9ba7645f" map="2100"/>
        </interleave>
        <part repeat="5242880">FF</part>

        <!-- 0x2380000  68000 sound program, 0x40000 (0x20000 used, byte-swapped) -->
        <interleave output="16">
            <part name="epr-16985.7" crc="8c4d9056" map="12"/>
        </interleave>
        <part repeat="131072">FF</part>

        <!-- 0x23c0000  MPCM samples, 0x800000 -->
        <part name="mpr-16986.32" crc="559612f9"/>
        <part repeat="2097152">FF</part>
        <part name="mpr-16988.4" crc="bc705875"/>
        <part name="mpr-16989.5" crc="1b616b31"/>

        <!-- 0x2bc0000  comms program, 0x20000 -- ROMREGION_ERASE00 in MAME,
             so this game has none and the region is zero, not FF. -->
        <part repeat="131072">00</part>

        <!-- 0x2be0000  TGP math tables, 0x40000 (shared Model 2 CPU board) -->
        <interleave output="32">
            <part name="opr-14742a.45" crc="90c6b117" map="0021"/>
            <part name="opr-14743a.46" crc="ae7f446b" map="2100"/>
        </interleave>

    </rom>
</misterromdescription>
