<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Fighting Vipers (Revision B) (Model 2B-CRX). Derived from MAME
      0.289 model2.cpp ROM_START(fvipersb), a clone of fvipers. For
      the Model 2B build (branch model2b, Model2.sv M2_2B: the
      ADSP-21062 SHARC as the coprocessor); the 2A and 2C cores cannot
      run it. Study R1024 (this set's census), R1031.

      MAME 0.289: MACHINE_NOT_WORKING. The Revision B program
      (epr-18604b - 18607b) and data EPROMs (epr-18608b - 18610b);
      every other ROM is the Revision D set's. EXPECTED NOT TO RUN: as
      fvipers (R1024: dual moves and PM-bus data, not in m2b_sharc).
      No protection, no patches.

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py, the 2B slots as Dead or Alive (Model 2B)'s):
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window, ROM_COPY mirrors
                   written out)
        0x2080000  4 MB of zeros (the 2B core keeps the SHARC's DM page at
                   its start, SDRAM byte 0x2080000, 128 KB)
        0x2480000  256 KB of zeros (the 2A TGP's tables; 2B has none)
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB          -> SDRAM byte 0x3400000
        0x2D40000  i960 program 512 KB-2 MB    -> SDRAM byte 0x2600000
        0x2EC0000  copro data, 4 MB (the SHARC's data ROM) -> SDRAM byte 0x2780000
        0x32C0000  texture-coordinate ROM, 16 MB -> SDRAM byte 0x4000000
        0x42C0000  polygons                    -> SDRAM byte 0x5000000
      Image: 0x4EC0000 bytes. Every stretch MAME's region does not load is
      written as MAME's fill (0, or 0xFF where the region is ERASEFF).

      Index 4, the game ID: 0x1A, BORROWED from Motor Raid (R887),
      because it is one of the two IDs that give both the large layout
      and the SHARC's data ROM (on 2B the SHARC's data-ROM reads
      (0x1c00000) come from the copro-data slot only for IDs 0x10 and
      0x18-0x1B (Model2.sv a2_copro_rom); for every other ID they read
      0; this set reads it 598 times a vblank (fvipers), R1024; with a
      digital ID those reads would be 0). What it implies: Motor
      Raid's ANALOG profile, not this game's controls - IN0 coin J4,
      test J6, service J7, J5 on bit 6 and J8 on bit 5; IN1 only bits
      4 / 5 (J12 / J13); AN0 the accelerator, AN1 the brake, AN2 the
      steering reversed - and Motor Raid's luma-row ranges (R900). For
      a fighter that means NO STICK OR BUTTONS and NO START 1: attract
      only. An ID of its own (large layout, data ROM, its own profile)
      is RTL work. Bit 7 is SET in this MRA (0x9A): the 15 kHz CRT
      flag (R795), which starts the core in 15 kHz interlaced whatever
      the OSD says (R908).
    -->
    <name>Fighting Vipers (Revision B) [15kHz CRT]</name>
    <setname>fvipersb</setname>
    <rbf>Model2B</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>9A 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Sega</manufacturer>
    <category>Fighter</category>

    <rom index="0" zip="fvipersb.zip|fvipers.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-18606b.15" crc="3b6d1697" map="0021"/>
            <part name="epr-18607b.16" crc="2e6c2d91" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18604b.13" crc="e4af1048" map="0021"/>
            <part name="epr-18605b.14" crc="78a6668f" map="2100"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <interleave output="32">
            <part name="mpr-18614.11" crc="0ebc899f" map="0021"/>
            <part name="mpr-18615.12" crc="018abdb7" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-18612.9" crc="1f174cd1" map="0021"/>
            <part name="mpr-18613.10" crc="f057cdf2" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18610b.7" crc="5f227d7c" map="0021"/>
            <part name="epr-18611b.8" crc="39a75fee" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18608b.5" crc="7df5082f" map="0021"/>
            <part name="epr-18609b.6" crc="e771fec9" map="2100"/>
        </interleave>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots (the 2B core keeps the
                     SHARC's DM page at its start, SDRAM byte 0x2080000, 128 KB) -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB: none on 2B (no TGP) -->
        <part repeat="262144">00</part>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-18628.31" crc="aa7dd79f" map="12"/>
        </interleave>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped); moved by the
                     loader to SDRAM byte 0x3400000 -->
        <interleave output="16">
            <part name="mpr-18629.32" crc="5d0006cc" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-18630.33" crc="9d405615" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-18631.34" crc="9dae5b45" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-18632.35" crc="39da6805" map="12"/>
        </interleave>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <part repeat="1572864">00</part>

        <!-- 0x2EC0000  copro data, 4 MB (R862): the SHARC's data ROM, MAME's 4 MB -->
        <interleave output="32">
            <part name="mpr-18622.29" crc="c74d99e3" map="0021"/>
            <part name="mpr-18623.30" crc="746ae931" map="2100"/>
        </interleave>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897; the loader's third
                     remap puts it at SDRAM byte 0x4000000) -->
        <interleave output="32">
            <part name="mpr-18626.27" crc="9df0a961" map="0021"/>
            <part name="mpr-18624.25" crc="1d74433e" map="2100"/>
        </interleave>
        <part repeat="4194304">00</part>
        <interleave output="32">
            <part name="mpr-18627.28" crc="946175a0" map="0021"/>
            <part name="mpr-18625.26" crc="182fd572" map="2100"/>
        </interleave>
        <part repeat="4194304">00</part>

        <!-- 0x42C0000  polygons, 12 MB (R897; SDRAM byte 0x5000000) -->
        <interleave output="32">
            <part name="mpr-18616.17" crc="15a239be" map="0021"/>
            <part name="mpr-18619.21" crc="9d5e8e2b" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-18617.18" crc="a62cab7d" map="0021"/>
            <part name="mpr-18620.22" crc="4d432afd" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-18618.19" crc="adab589f" map="0021"/>
            <part name="mpr-18621.23" crc="f5eeaa95" map="2100"/>
        </interleave>

    </rom>

    <!-- BORROWED ID: the analog profile's order (J4 Coin, J5 Start, J6 Test,
         J7 Service, J8 View, J9 Hand Brake, J10 Accel, J11 Brake, J12 Gear Up,
         J13 Gear Down), named by what each reaches in this game; "-" reaches
         nothing it reads. -->
    <buttons names="Coin,-,Test,Service,Start 2,-,-,-,Down,Up"/>
</misterromdescription>
