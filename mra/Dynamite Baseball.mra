<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Dynamite Baseball (Model 2B-CRX). Derived from MAME 0.289
      model2.cpp ROM_START(dynabb), the parent set. For the Model 2B
      build (branch model2b, Model2.sv M2_2B: the ADSP-21062 SHARC as
      the coprocessor); the 2A and 2C cores cannot run it. Study R1024
      (this set's census), R1031.

      MAME 0.289: MACHINE_NOT_WORKING, but R1024's census played it: a
      4,096-word SHARC program, 246 DM words, nothing past the first
      cut's list (attract up to 245 k words a vblank). It writes
      0x01c80000 five times (2A's i8251 address, unmapped on 2B:
      dropped, R1031). No protection, no patches.

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py, the 2B slots as Dead or Alive (Model 2B)'s):
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window, ROM_COPY mirrors
                   written out)
        0x2080000  4 MB of zeros (the 2B core keeps the SHARC's DM page at
                   its start, SDRAM byte 0x2080000, 128 KB)
        0x2480000  256 KB of zeros (the 2A TGP's tables; 2B has none)
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB          -> SDRAM byte 0x3400000
        0x2D40000  i960 program 512 KB-2 MB    -> SDRAM byte 0x2600000
        0x2EC0000  copro data, 4 MB (the SHARC's data ROM) -> SDRAM byte 0x2780000
        0x32C0000  texture-coordinate ROM, 16 MB -> SDRAM byte 0x4000000
        0x42C0000  polygons                    -> SDRAM byte 0x5000000
      Image: 0x52C0000 bytes. Every stretch MAME's region does not load is
      written as MAME's fill (0, or 0xFF where the region is ERASEFF).

      Index 4, the game ID: 0x13, BORROWED from Hanguk Pro Yagu 98
      (R887), the other baseball game: the large layout and the
      DIGITAL three-button profile (this game reads two buttons, IN1 /
      IN2 bits 0 and 1). What it implies: the two BAT SWING inputs
      (MAME's BAT1 / BAT2 on AN0 / AN1, pedals resting at 0x00) read
      0xFF, swing held, on every digital profile - batting is not
      expected to work; and Hanguk Pro Yagu 98's luma-row ranges
      (R900), not ones measured on this game. No 2B ID reads the swing
      from a stick; that is RTL work. Bit 7 would be the 15 kHz CRT
      flag.
    -->
    <name>Dynamite Baseball</name>
    <setname>dynabb</setname>
    <rbf>Model2B</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>13 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Sega</manufacturer>
    <category>Sports</category>

    <rom index="0" zip="dynabb.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-19170.15" crc="e00eb49e" map="0021" offset="0x000000" length="0x040000"/>
            <part name="epr-19171.16" crc="9878d67d" map="2100" offset="0x000000" length="0x040000"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <part repeat="8388608">00</part>
        <interleave output="32">
            <part name="mpr-19176.9" crc="2c4e90f5" map="0021"/>
            <part name="mpr-19177.10" crc="b0f1e512" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-19174.7" crc="057e5200" map="0021"/>
            <part name="mpr-19175.8" crc="85254156" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-19172.5" crc="9214aaaf" map="0021"/>
            <part name="mpr-19173.6" crc="31adbeed" map="2100"/>
        </interleave>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots (the 2B core keeps the
                     SHARC's DM page at its start, SDRAM byte 0x2080000, 128 KB) -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB: none on 2B (no TGP) -->
        <part repeat="262144">00</part>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-19184.31" crc="c013a163" map="12"/>
        </interleave>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped); moved by the
                     loader to SDRAM byte 0x3400000 -->
        <interleave output="16">
            <part name="mpr-19185.32" crc="5175b7d8" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-19186.33" crc="f23440b5" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-19187.34" crc="20918769" map="12"/>
        </interleave>
        <part repeat="2097152">00</part>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <interleave output="32">
            <part name="epr-19170.15" crc="e00eb49e" map="0021" offset="0x040000" length="0x040000"/>
            <part name="epr-19171.16" crc="9878d67d" map="2100" offset="0x040000" length="0x040000"/>
        </interleave>
        <interleave output="32">
            <part name="epr-19168.13" crc="041da66b" map="0021"/>
            <part name="epr-19169.14" crc="91a5acef" map="2100"/>
        </interleave>

        <!-- 0x2EC0000  copro data, 4 MB (R862): the SHARC's data ROM, MAME's region empty -->
        <part repeat="4194304">00</part>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897; the loader's third
                     remap puts it at SDRAM byte 0x4000000) -->
        <interleave output="32">
            <part name="mpr-19183.27" crc="5e29074b" map="0021"/>
            <part name="mpr-19182.25" crc="c899923d" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-19183.27" crc="5e29074b" map="0021"/>
            <part name="mpr-19182.25" crc="c899923d" map="2100"/>
        </interleave>

        <!-- 0x42C0000  polygons, 16 MB (R897; SDRAM byte 0x5000000) -->
        <interleave output="32">
            <part name="mpr-19178.17" crc="0d621e21" map="0021"/>
            <part name="mpr-19180.21" crc="d2e311a5" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-19179.18" crc="337a4ec2" map="0021"/>
            <part name="mpr-19181.22" crc="09a86c33" map="2100"/>
        </interleave>

    </rom>

    <!-- Player 1 on joystick 1, player 2 on joystick 2, the same buttons
         (VF2's order: R887's three-button profile). -->
    <buttons names="Button 1,Button 2,-,Start,Coin,Test,Service"/>
</misterromdescription>
