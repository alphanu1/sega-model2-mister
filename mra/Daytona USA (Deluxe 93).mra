<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Layout contract: docs/rom-layout.md. Derived from MAME 0.289
      model2.cpp ROM_START(daytona93).

      FULL 43.62 MB SET. The SDRAM controller now addresses 128 MB (11 column
      bits, 26-bit word address), proven against the device model at both
      geometries: make test_m2_sdram and test_m2_sdram128.

      This file was briefly trimmed to 22.25 MB because the controller addressed
      only 32 MB and the full set wrapped over its own start, which the board
      showed as FFFFFFFF where the i960 program should be. That constraint is
      gone; the trim is not a thing to reinstate.

      The ROM_COPY mirrors in main_data (0x900000 -> 0xa00000..0xf00000) are
      deliberately NOT repeated here. Shipping six duplicate megabytes over
      ioctl every boot to express an address decode belongs in the core.
    -->
    <name>Daytona USA (Deluxe '93)</name>
    <setname>daytona93</setname>
    <rbf>Model2</rbf>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Sega</manufacturer>
    <category>Driving</category>

    <rom index="0" zip="daytona93.zip" md5="none">

        <!-- 0x0000000  i960 program, 0x40000 -->
        <interleave output="32">
            <part name="epr-16530a.12" crc="39e962b5" map="0021"/>
            <part name="epr-16531a.13" crc="693126eb" map="2100"/>
        </interleave>

        <!-- 0x0040000  i960 data, 0xa00000 -->
        <interleave output="32">
            <part name="mpr-16528.10" crc="9ce591f6" map="0021"/>
            <part name="mpr-16529.11" crc="f7095eaf" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16526.8" crc="5273b8b5" map="0021"/>
            <part name="mpr-16527.9" crc="fc4cb0ef" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-16534a.6" crc="1bb0d72d" map="0021"/>
            <part name="epr-16535a.7" crc="459a8bfb" map="2100"/>
        </interleave>

        <!-- 0x0a40000  copro data, 0x400000 -->
        <interleave output="32">
            <part name="mpr-16537.ic28" crc="36b7c35a" map="0021"/>
            <part name="mpr-16536.ic29" crc="6d6afed9" map="2100"/>
        </interleave>

        <!-- 0x0e40000  textures, 0x800000 -->
        <interleave output="32">
            <part name="mpr-16522.25" crc="55d39a57" map="0021"/>
            <part name="mpr-16521.24" crc="af1934fb" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16517.27" crc="4705d3dd" map="0021"/>
            <part name="mpr-16516.26" crc="a260d45d" map="2100"/>
        </interleave>

        <!-- 0x1640000  polygons, 0xd00000 -->
        <interleave output="32">
            <part name="mpr-16523.ic16" crc="2f484d42" map="0021"/>
            <part name="mpr-16518.ic20" crc="df683bf7" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16524.ic17" crc="34658bd7" map="0021"/>
            <part name="mpr-16519.ic21" crc="facd1c81" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-16525.ic18" crc="fb517521" map="0021"/>
            <part name="mpr-16520.ic22" crc="d66bd9bd" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="epr-16646.ic19" crc="7ba9fd6b" map="0021"/>
            <part name="epr-16645.ic23" crc="78fe0b8a" map="2100"/>
        </interleave>

        <!-- 0x2340000  68000 sound program, 0x40000 (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-16489.7" crc="c20e543e" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="epr-16490.8" crc="c24edaab" map="12"/>
        </interleave>

        <!-- 0x2380000  MPCM samples, 0x800000 -->
        <part name="mpr-16491.32" crc="89920903"/>
        <part name="mpr-16492.33" crc="459e701b"/>
        <part name="mpr-16493.4"  crc="9990db15"/>
        <part name="mpr-16494.5"  crc="600e1d6c"/>

        <!-- 0x2b80000  comms program, 0x20000 -->
        <part name="epr-16726.bin" crc="c179b8c7"/>

    </rom>

    <!-- No DIP switches are wired yet; the core has no inputs. -->
</misterromdescription>
