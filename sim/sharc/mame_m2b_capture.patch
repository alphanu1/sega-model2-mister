+// R1027: the 2B replay capture (R924_CAP=<dir>): <dir>/events.bin, 9-byte records <u8 type,
+// u32 a, u32 b> in emulation order --
+//   C copro_ctl1 write (a = mask, b)   H host IOP-window write (a = dword offset, b)
+//   U upload word (a = n, b = the 16 bits)   B copro_boot (a = n)
+//   I i960 FIFO push (b)   N function-port push (a = offset, b = word pushed)
+//   P SHARC pop (a = n, b)   S SHARC read of an empty in FIFO (a = n)
+//   O SHARC push (a = n | 0x80000000 if the out FIFO already held 16, b)
+//   R buffer-RAM / data-ROM read by the SHARC (a = addr, b)   W buffer-RAM write (a, b)
+//   F vblank (a = frame)
+static uint32_t r1027_np = 0, r1027_no = 0;
 u32 model2b_state::copro_sharc_fifo_in_r()
 {
 	if (m_copro_fifo_in->is_empty() && !machine().side_effects_disabled()) m2b_fin_empty();
+	if (r924_on() && !machine().side_effects_disabled())
+	{
+		if (m_copro_fifo_in->is_empty()) { r924_ev('S', r1027_np, 0); return m_copro_fifo_in->read(); }
+		u32 v = m_copro_fifo_in->read();
+		r924_ev('P', r1027_np++, v);
+		return v;
+	}
 	return m_copro_fifo_in->read();
 }
 
+void model2b_state::copro_sharc_fifo_out_w(u32 data)
+{
+	if (r924_on() && !machine().side_effects_disabled())
+		r924_ev('O', r1027_no++ | (m_copro_fifo_out->is_full() ? 0x80000000u : 0), data);
+	m_copro_fifo_out->write(data);
+}
+
+u32 model2b_state::copro_sharc_rom_r(offs_t offset)
+{
+	u32 v = m_copro_data->as_u32(offset & ((m_copro_data->bytes() >> 2) - 1));
+	if (r924_on() && !machine().side_effects_disabled()) r924_ev('R', 0x1c00000 + offset, v);
+	return v;
+}
+
+void model2b_state::copro_sharc_iop_w(offs_t offset, u32 data)
+{
+	if (r924_on()) r924_ev('H', offset, data);
+	m_copro_adsp->external_iop_write(offset, data);
+}
+
 u32 model2b_state::copro_sharc_buffer_r(offs_t offset)
 {
+	if (r924_on() && !machine().side_effects_disabled()) r924_ev('R', 0x1400000 + offset, m_bufferram[offset & 0x7fff]);
 	return m_bufferram[offset & 0x7fff];
 }
 
 void model2b_state::copro_sharc_buffer_w(offs_t offset, u32 data)
 {
+	if (r924_on()) r924_ev('W', 0x1400000 + offset, data);
 	m_bufferram[offset & 0x7fff] = data;
 }
 
