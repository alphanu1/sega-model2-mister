+// R1027: R1026's data memory -- block 1 words below 8 K on chip, every other internal word
+// (block 1 from 8 K, block 0's data words) in SDRAM behind a small read cache, writes posted
+// (write-through, a write updates a line it hits, no allocate). Direct-mapped caches of
+// 16 .. 512 lines of 1 .. 16 words and two-way LRU ones, counted over the instructions'
+// accesses; reads that miss, and the writes, per geometry, in totals.txt. Paced, M2B_XDM
+// cycles are charged a read miss of the geometry M2B_DMC=<lines>:<words>[:2] (default 64:8).
+namespace m2b {
+static const int NDL = 6, NDW = 4;
+static const unsigned dl_n[NDL] = { 16, 32, 64, 128, 256, 512 }, dw_n[NDW] = { 1, 4, 8, 16 };
+static int32_t xtag[NDL][NDW][512], xtag2[NDL][NDW][2][256]; static uint8_t xlru[NDL][NDW][256];
+static uint64_t xmiss[NDL][NDW], xmiss2[NDL][NDW], xrd = 0, xwr = 0, xall = 0;
+static bool xinit = false; static int xdm = 0, xsel_l = 2, xsel_w = 2, xsel_2 = 0;
+static inline int dmext(uint32_t key, int w)
+{
+	if (!xinit)
+	{
+		for (auto &a : xtag) for (auto &b : a) for (auto &t : b) t = -1;
+		for (auto &a : xtag2) for (auto &b : a) for (auto &c : b) for (auto &t : c) t = -1;
+		xinit = true;
+		if (const char *x = getenv("M2B_XDM")) xdm = atoi(x);
+		if (const char *c = getenv("M2B_DMC"))
+		{
+			unsigned l = 64, ww = 8, two = 0; sscanf(c, "%u:%u:%u", &l, &ww, &two);
+			for (int i = 0; i < NDL; i++) if (dl_n[i] == l) xsel_l = i;
+			for (int j = 0; j < NDW; j++) if (dw_n[j] == ww) xsel_w = j;
+			xsel_2 = two == 2;
+		}
+	}
+	xall++;
+	// on chip: block 1 (key bit 15) words below 8 K
+	if ((key & 0x8000) && (key & 0x7fff) < 0x2000) return 0;
+	if (w) xwr++; else xrd++;
+	int charge = 0;
+	for (int i = 0; i < NDL; i++)
+		for (int j = 0; j < NDW; j++)
+		{
+			uint32_t line = key / dw_n[j];
+			uint32_t ix = line & (dl_n[i] - 1);
+			bool hit = xtag[i][j][ix] == int32_t(line);
+			if (!w && !hit) { xtag[i][j][ix] = int32_t(line); xmiss[i][j]++; if (!xsel_2 && i == xsel_l && j == xsel_w) charge = xdm; }
+			// two-way, the same capacity: half the sets
+			uint32_t sets = dl_n[i] / 2, s2 = line & (sets - 1);
+			int way = xtag2[i][j][0][s2] == int32_t(line) ? 0 : xtag2[i][j][1][s2] == int32_t(line) ? 1 : -1;
+			if (way >= 0) xlru[i][j][s2] = uint8_t(way ^ 1);
+			else if (!w) { int v = xlru[i][j][s2]; xtag2[i][j][v][s2] = int32_t(line); xlru[i][j][s2] = uint8_t(v ^ 1); xmiss2[i][j]++; if (xsel_2 && i == xsel_l && j == xsel_w) charge = xdm; }
+		}
+	return charge;
+}
+static void dmext_dump(FILE *f)
+{
+	fprintf(f, "dmext accesses %llu offchip reads %llu writes %llu\n", (unsigned long long)xall, (unsigned long long)xrd, (unsigned long long)xwr);
+	for (int i = 0; i < NDL; i++)
+		for (int j = 0; j < NDW; j++)
+			fprintf(f, "dmext %u x %u (%u words) misses dm %llu 2way %llu\n", dl_n[i], dw_n[j], dl_n[i] * dw_n[j],
+				(unsigned long long)xmiss[i][j], (unsigned long long)xmiss2[i][j]);
+}
