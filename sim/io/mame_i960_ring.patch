+// ---- R935: THE REGISTER RING'S HAZARDS (Sega Model 2 MiSTer core). R935_RING=<n>
+// models a chip-style local-register cache of the n newest saved frames (a
+// frame's save area is written only when a call finds the ring full, read back
+// only when a return finds it empty; flushreg writes all) BESIDE MAME's own
+// rule, which is unchanged, and logs every program load or store that touches
+// a save area the modelled ring still holds: there the core's RING build reads
+// or writes memory MAME has already made current. cat 0: MAME has spilled
+// that frame (a true divergence); cat 1: MAME's own 4-frame cache holds it too.
+// R935_OUT=<file>: first hits as they happen, totals at exit.
+#include <deque>
+#include <map>
+#include <tuple>
+namespace {
+struct r935_ring_t {
+	bool tried = false; int n = 0; FILE *f = nullptr;
+	std::deque<uint32_t> ring;
+	std::map<std::tuple<uint32_t, int, int>, uint64_t> hits;
+	uint64_t calls = 0, rets = 0, spills = 0, flushes = 0, maxd = 0;
+	bool on() {
+		if (!tried) { tried = true; const char *e = getenv("R935_RING");
+			if (e) { n = atoi(e); const char *o = getenv("R935_OUT"); f = fopen(o ? o : "/tmp/r935_ring.txt", "w"); } }
+		return n > 0 && f;
+	}
+	~r935_ring_t() {
+		if (!f) return;
+		fprintf(f, "TOTAL calls %llu rets %llu spills %llu flushreg %llu\n", (unsigned long long)calls, (unsigned long long)rets,
+			(unsigned long long)spills, (unsigned long long)flushes);
+		for (auto &h : hits) fprintf(f, "PC %08x %s cat %d n %llu\n", std::get<0>(h.first), std::get<1>(h.first) ? "W" : "R",
+			std::get<2>(h.first), (unsigned long long)h.second);
+		fclose(f);
+	}
+};
+r935_ring_t &r935() { static r935_ring_t r; return r; }
+}
+
+void i960_cpu_device::r935_access(uint32_t addr, int size, bool wr)
+{
+	auto &R = r935();
+	if (!R.on() || R.ring.empty()) return;
+	for (size_t k = 0; k < R.ring.size(); k++) {
+		const uint32_t fb = R.ring[k];
+		if (addr < fb + 64 && addr + uint32_t(size) > fb) {
+			int cat = 0;
+			for (int j = 0; j < std::min(m_rcache_pos, int(I960_RCACHE_SIZE)); j++) if (m_rcache_frame_addr[j] == fb) cat = 1;
+			auto key = std::make_tuple(m_PIP, wr ? 1 : 0, cat);
+			if (R.hits[key]++ == 0)
+				fprintf(R.f, "FIRST %.4f pc %08x %s addr %08x frame %08x ring pos %d of %d cat %d fp %08x\n",
+					machine().time().as_double(), m_PIP, wr ? "W" : "R", addr, fb, int(R.ring.size() - 1 - k), int(R.ring.size()), cat, m_r[I960_FP]);
+			fflush(R.f);
+			return;
+		}
+	}
+}
