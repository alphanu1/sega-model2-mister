R969: MAME 0.289's MB86233 floating point with hardware-style variants, set
from the environment (Sega Model 2 core for MiSTer FPGA, study R969, GitHub
#34). M2_TGP_FMODE bits: 1 round toward zero, 2 flush denormals in and out,
4 saturate overflow to the largest finite and NaN to +0; 0 (or unset) is
MAME's host IEEE round-to-nearest, and runs Daytona frame-identical to the
unpatched build. Every fadd / fsbd / fcpd / fml / fmsd / fmrd / fsmd / fspd /
fdvd and the b+a / b-a forms go through it. What it showed: the AI car's
climb onto Daytona's wall collision surface happens in every mode.
Apply in a MAME 0.289 tree: patch -p1 < mame_tgp_fmode.patch, then e.g.
make SUBTARGET=m2lod SOURCES=src/mame/sega/model2.cpp (16 s incremental).
The patch is MAME code (BSD-3-Clause, mb86233.cpp's own licence); a tool,
not part of the core.

diff --git a/src/devices/cpu/mb86233/mb86233.cpp b/src/devices/cpu/mb86233/mb86233.cpp
index 2e483756..fecc3127 100644
--- a/src/devices/cpu/mb86233/mb86233.cpp
+++ b/src/devices/cpu/mb86233/mb86233.cpp
@@ -3,10 +3,33 @@
 
 #include "emu.h"
 #include "mb86233.h"
+
+
 #include "mb86233d.h"
 
 #include "corefloat.h"
 
+// #34 experiment (sega-model2-mister R969): M2_TGP_FMODE bits -- 1 round toward
+// zero, 2 flush denormals in and out, 4 saturate overflow to the largest
+// finite and NaN to +0. 0 = MAME's host IEEE (round to nearest).
+#include <cmath>
+#include <cstdlib>
+static int tgp_fmode() { static int m = -1; if (m < 0) { const char *e = getenv("M2_TGP_FMODE"); m = e ? atoi(e) : 0; } return m; }
+static u32 tgp_fop(u32 a, u32 b, char op)
+{
+	const int md = tgp_fmode();
+	if (md & 2) { if (((a >> 23) & 0xff) == 0) a &= 0x80000000; if (((b >> 23) & 0xff) == 0) b &= 0x80000000; }
+	double x = u2f(a), y = u2f(b), r;
+	switch (op) { case '+': r = x + y; break; case '-': r = x - y; break; case '*': r = x * y; break; default: r = x / y; break; }
+	float f = float(r);
+	if ((md & 1) && std::isfinite(r)) { if (std::fabs(double(f)) > std::fabs(r)) f = std::nextafter(f, 0.0f); }
+	u32 u = f2u(f);
+	if ((md & 2) && ((u >> 23) & 0xff) == 0) u &= 0x80000000;
+	if (md & 4) { if (std::isnan(f)) u = 0; else if (std::isinf(f)) u = (u & 0x80000000) | 0x7f7fffff; }
+	return u;
+}
+
+
